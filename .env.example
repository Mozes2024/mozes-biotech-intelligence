# Copy to .env (never commit .env). All keys are optional; the core system works without them.

# Required by SEC fair-access policy for EDGAR requests: "Your Name your@email.com"
SEC_USER_AGENT=

# Optional end-of-day price provider (https://www.tiingo.com) — free tier available
TIINGO_API_KEY=

# Optional AI provider for document interpretation. If empty, the system runs without AI.
ANTHROPIC_API_KEY=
MOZES_AI_MODEL=

# SQLite path
MOZES_DB_PATH=mozes.db

# Breaking-catalyst hot lane (optional push). Pages is never the alert transport.
# MOZES_SEC_HOT=1 shortens SEC submissions cache TTL to 60s for hot polls.
# MOZES_SEC_HOT_TTL=60
# MOZES_PRIMARY_FEEDS=1
# MOZES_ALERT_DISPATCH=1
# MOZES_ALERT_LOG=1
# Lowest priority that is queued for push (P1 = watchlist-only material, P2, P3 = unattributed).
# MOZES_ALERT_MIN_PRIORITY=P2
# Push is owned by the persistent worker. Inside GitHub Actions push channels are disabled
# unless MOZES_PUSH_FROM_ACTIONS=1 (and then the worker must not push the same topic).
# MOZES_PUSH_FROM_ACTIONS=0
MOZES_NTFY_URL=
MOZES_WEBHOOK_URL=
