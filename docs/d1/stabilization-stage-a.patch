new file mode 100644
index 0000000..d56444b
--- /dev/null
+++ b/cloudflare/src/forward-policy.js
@@ -0,0 +1,25 @@
+// Code-only Stage A fence. Old work remains durable and visible for manual review.
+export const MAX_ATTEMPTS = 5;
+export const FORWARD_SQL = "julianday(first_seen_at)>=julianday(?) AND julianday(CASE WHEN source='sec' THEN accepted_at ELSE published_at END)>=julianday(?)";
+export function activation(env, now = new Date().toISOString()) {
+  const value = env.EDGE_FORWARD_ONLY_FROM;
+  if (typeof value !== 'string' || !/[Zz]|[+-]\d\d:\d\d$/.test(value) || !Number.isFinite(Date.parse(value)) || Date.parse(value)>Date.parse(now))
+    throw Error('forward-only activation evidence missing or invalid');
+  return new Date(value).toISOString();
+}
+export function forward(event, env, now = new Date().toISOString()) {
+  const at = Date.parse(activation(env, now));
+  return Date.parse(event.first_seen_at)>=at && Date.parse(event.source==='sec'?(event.accepted_at||event.published_at):event.published_at)>=at;
+}
+export async function queueHealth(db, env, now = new Date().toISOString()) {
+  const from = activation(env, now);
+  return db.prepare(`WITH queue AS (SELECT *,COALESCE((${FORWARD_SQL}),0) AS forward_ok FROM edge_events)
+    SELECT COUNT(*) AS events,
+      SUM(CASE WHEN analysis_status<>'complete' THEN 1 ELSE 0 END) AS analysis_pending,
+      SUM(CASE WHEN analysis_status='blocked' THEN 1 ELSE 0 END) AS analysis_blocked,
+      SUM(CASE WHEN material=1 AND enrichment_ack_at IS NULL THEN 1 ELSE 0 END) AS enrichment_pending,
+      SUM(CASE WHEN material=1 AND enrichment_ack_at IS NULL AND (forward_ok=0 OR (enrichment_attempts>=${MAX_ATTEMPTS} AND (enrichment_retry_at IS NULL OR enrichment_retry_at<=?))) THEN 1 ELSE 0 END) AS enrichment_manual_review,
+      SUM(CASE WHEN material=1 AND enrichment_ack_at IS NULL AND forward_ok=1 AND enrichment_attempts<${MAX_ATTEMPTS} AND (enrichment_retry_at IS NULL OR enrichment_retry_at<=?) THEN 1 ELSE 0 END) AS enrichment_eligible,
+      SUM(CASE WHEN material=1 AND enrichment_ack_at IS NULL AND enrichment_retry_at>? THEN 1 ELSE 0 END) AS awaiting_completion
+    FROM queue`).bind(from,from,now,now,now).first();
+}
