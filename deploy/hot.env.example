# Copy to /etc/mozes/hot.env (systemd) or pass with `docker run --env-file`. Never commit the real file.

# Required by SEC fair-access policy: "Your Name your@email.com"
SEC_USER_AGENT=

# Push target — the worker is the only process that pushes.
# ntfy: install the ntfy app, subscribe to a long random topic name, put the URL here.
MOZES_NTFY_URL=
MOZES_WEBHOOK_URL=
MOZES_ALERT_MIN_PRIORITY=P2

# Dead-man's switch: a check URL that alerts you when pings stop (e.g. healthchecks.io).
MOZES_HEARTBEAT_URL=

# State paths come from the systemd unit (/var/lib/mozes) or the Dockerfile (/data).
MOZES_BACKUP_HOURS=6
MOZES_BACKUP_KEEP=8

MOZES_SEC_HOT=1
MOZES_NEWS_ENABLED=1
