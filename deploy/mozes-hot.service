[Unit]
Description=MOZES breaking-catalyst hot-lane worker
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=mozes
WorkingDirectory=/opt/mozes
Environment=MOZES_DB_PATH=/var/lib/mozes/mozes-hot.db
Environment=MOZES_HTTP_CACHE=/var/lib/mozes/http-cache
Environment=MOZES_BACKUP_DIR=/var/lib/mozes/backups
EnvironmentFile=/etc/mozes/hot.env
ExecStart=/opt/mozes/.venv/bin/python -m mozes.hot_monitor --interval 60
Restart=always
RestartSec=10
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ReadWritePaths=/var/lib/mozes

[Install]
WantedBy=multi-user.target
